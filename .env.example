# Copy to .env on the server (chmod 600 .env). Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENVIRONMENT=production
APP_NAME=TeamPath
APP_DOMAIN=learn.example.com
BASE_URL=https://learn.example.com

# Database: owner (migrations only) and the restricted app role (row-level security applies)
DB_OWNER_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too

SECRET_KEY=change-me-48-random-chars
FLET_SECRET_KEY=change-me-another-48-random-chars
ENCRYPTION_KEY=generate-a-fernet-key

# New organizations wait for platform-admin approval
REQUIRE_ORG_APPROVAL=true

# Email (required in production for invitations, verification and resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true

# Optional: breached-password check (sends only a 5-char hash prefix)
HIBP_CHECK=true

# Optional antivirus (with `--profile av`)
CLAMD_HOST=

# Session policy
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
REMEMBER_DAYS=14
MAX_UPLOAD_MB=200

# Content-Security-Policy: enforce | report | off
CSP_MODE=enforce

# Traefik integration (match your existing Traefik setup)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Images (set by the deploy workflow)
APP_IMAGE=ghcr.io/sukarnar/teampath
WORKER_IMAGE=ghcr.io/sukarnar/teampath-worker
APP_TAG=latest

# Backups (scripts/backup.sh)
BACKUP_PASSPHRASE=change-me-long-random-passphrase
